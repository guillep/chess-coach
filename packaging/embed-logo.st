"Regenerates ChessCoachWidgets class>>embeddedLogoPng from assets/chessmate-128.png.
The packaged app has no repository to read assets/ from, so the logo lives in the
code. Run it in the development image when the logo changes, then commit the method."
| png encoded |
png := (IceRepository registry detect: [ :each | each name = 'chess-coach' ]) location
	/ 'assets' / 'chessmate-128.png'.
encoded := png binaryReadStream upToEnd base64Encoded.
ChessCoachWidgets class
	compile: 'embeddedLogoPng
	"The PNG of assets/chessmate-128.png. Generated by packaging/embed-logo.st: regenerate it, don''t edit it"

	^ ''' , encoded , ''' base64Decoded'
	classified: 'assets'.
