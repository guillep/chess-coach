{ #category : 'accessing' }
LiviusPieceSet >> byteArrayForPiece: aPiece color: aColor [

	aColor = #white ifTrue: [
			aPiece = #king ifTrue: [ ^ self whiteKing ].
			aPiece = #queen ifTrue: [ ^ self whiteQueen ].
			aPiece = #rook ifTrue: [ ^ self whiteRook ].
			aPiece = #bishop ifTrue: [ ^ self whiteBishop ].
			aPiece = #knight ifTrue: [ ^ self whiteKnight ].
			aPiece = #pawn ifTrue: [ ^ self whitePawn ] ].
	aColor = #black ifTrue: [
			aPiece = #king ifTrue: [ ^ self blackKing ].
			aPiece = #queen ifTrue: [ ^ self blackQueen ].
			aPiece = #rook ifTrue: [ ^ self blackRook ].
			aPiece = #bishop ifTrue: [ ^ self blackBishop ].
			aPiece = #knight ifTrue: [ ^ self blackKnight ].
			aPiece = #pawn ifTrue: [ ^ self blackPawn ] ].
	^ nil
]

